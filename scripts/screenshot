#!/usr/bin/env bash
# scripts/screenshot <out.png> [--frames N]
# Renders the scene on a hidden canvas (offscreen), writes a 1280x800 PNG,
# exits; non-zero on failure. Enters the dev shell itself if needed.
# Time: ~5 s warm (dev shell entry, load from cached FASLs, 10 frames,
# capture), on the desktop GPU and headless on lavapipe alike.
set -euo pipefail

usage() { echo "usage: scripts/screenshot <out.png> [--frames N]" >&2; exit 2; }

out=""
frames=""
while [ $# -gt 0 ]; do
  case "$1" in
    --frames) [ $# -ge 2 ] || usage; frames="$2"; shift 2 ;;
    --frames=*) frames="${1#--frames=}"; shift ;;
    -h|--help) usage ;;
    -*) usage ;;
    *) [ -z "$out" ] || usage; out="$1"; shift ;;
  esac
done
[ -n "$out" ] || usage
if [ -n "$frames" ] && ! [[ "$frames" =~ ^[1-9][0-9]*$ ]]; then usage; fi

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
out="$(realpath -m -- "$out")"

if [ -z "${LUV_DEV_SHELL:-}" ]; then
  exec nix develop --accept-flake-config "$root" -c "$root/scripts/screenshot" \
    "$out" ${frames:+--frames "$frames"}
fi

cd "$root"
export LIS_SCREENSHOT="$out"
exec sbcl --noinform --non-interactive \
  --eval '(require :asdf)' \
  --eval '(setf *compile-verbose* nil *compile-print* nil)' \
  --eval '(handler-bind ((warning (function muffle-warning))) (asdf:load-system "luv-in-space"))' \
  --eval "(luv-in-space:screenshot-main (uiop:getenv \"LIS_SCREENSHOT\")${frames:+ :frames $frames})"
