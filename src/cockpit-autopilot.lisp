(in-package #:luv-in-space)

;;; The AUTOPILOT screen's orbit plot (plan 32: Cockpit instruments, buttons,
;;; the grapple camera and messages; decision 127: Cockpit screens' contents
;;; in milestone 3: lines, modes, plots, colours and updates): the orbit
;;; plane seen from its normal side, Earth's disc about the plot's centre,
;;; the ship's predicted trajectory in cyan, the plan's path after its first
;;; unstarted burn dashed, Ap and Pe as diamonds, the ship's ring, the burns
;;; as ticks, the target's orbit projected into the plane in magenta. All
;;; segments of the :cab-lines pipeline, rebuilt with the screen's text (10 Hz).

(defparameter *autopilot-plot-fill-strips* 24 "Horizontal strips filling Earth's disc in the full plot.")
(defparameter *autopilot-plot-ring* 32 "Segments of the disc's outline.")
(defparameter *autopilot-plot-path-points* 110 "Points of one stored path at most.")
(defparameter *autopilot-plot-conic-points* 96 "Segments of an osculating orbit drawn for lack of nodes.")
(defparameter *autopilot-plot-target-points* 64 "Segments of the target's orbit.")
(defparameter *autopilot-plot-fraction* 0.9d0 "The farthest point's share of the plot's half-height.")
(defparameter *autopilot-plot-fill* #x24303A "Earth's disc.")
(defparameter *autopilot-plot-widths* '(:outline 0.0010f0 :path 0.0020f0 :target 0.0014f0 :mark 0.0016f0)
  "Line widths, metres.")

(defconstant +plot-points+ 420)
(defconstant +plot-segments+ 380)
(defconstant +plot-runs+ 8)

(defstruct (autopilot-plot (:copier nil) (:constructor %make-autopilot-plot))
  (region nil) (frame nil)
  (px (make-array +plot-points+ :element-type 'double-float :initial-element 0d0)
   :type (simple-array double-float (*)))
  (py (make-array +plot-points+ :element-type 'double-float :initial-element 0d0)
   :type (simple-array double-float (*)))
  (n 0 :type fixnum)
  (scale-n 0 :type fixnum)                  ; the points of the own orbit: the scale's
  (run-start (make-array +plot-runs+ :element-type 'fixnum :initial-element 0) :type (simple-array fixnum (*)))
  (run-end (make-array +plot-runs+ :element-type 'fixnum :initial-element 0) :type (simple-array fixnum (*)))
  (run-kind (make-array +plot-runs+ :initial-element nil) :type simple-vector)
  (runs 0 :type fixnum)
  (tick-x (make-array 8 :element-type 'double-float :initial-element 0d0) :type (simple-array double-float (*)))
  (tick-y (make-array 8 :element-type 'double-float :initial-element 0d0) :type (simple-array double-float (*)))
  (ticks 0 :type fixnum)
  (marks (make-array 6 :element-type 'double-float :initial-element 0d0)
   :type (simple-array double-float (*)))   ; Ap and Pe: x y each, then the ship's x y
  (mark-p nil)                              ; Ap and Pe known
  (segments 0 :type fixnum)                 ; written at the last update (for tests)
  (mode nil)                                ; nil, :full or :third at the last update
  (unit 0d0 :type double-float)             ; face metres per metre of orbit
  (cx 0f0 :type single-float) (cy 0f0 :type single-float) ; the plot's centre on the face
  (hw 0f0 :type single-float) (hh 0f0 :type single-float) ; and half-extents
  (ex (make-vec3) :type vec3) (ey (make-vec3) :type vec3) (eh (make-vec3) :type vec3)
  (evec (make-vec3) :type vec3) (q (make-vec3) :type vec3) (scratch (make-vec3) :type vec3)
  (cyan nil) (magenta nil) (grey nil) (fill nil)
  (grid nil))                               ; (x0 ytop row-height cell width height)

(defun make-autopilot-plot (line-batch)
  (let* ((panel (cockpit-panel :autopilot))
         (cap (panel-grid-cap panel)))
    (destructuring-bind (w h) (getf panel :size)
      (%make-autopilot-plot
       :region (line-batch-region line-batch +plot-segments+)
       :frame (panel-plane-frame :autopilot 0d0 0d0 0.002d0)
       :cyan (screen-line-colour *screen-cyan*) :magenta (screen-line-colour *screen-magenta*)
       :grey (screen-line-colour *screen-grey*) :fill (screen-line-colour *autopilot-plot-fill*)
       :grid (list (+ (* -0.5d0 w) 0.01d0) (- (* 0.5d0 h) 0.01d0)
                   (* +text-cell-height+ cap) (* +text-cell-width+ cap)
                   (first (getf panel :grid)))))))

;;; Geometry

(defun plot-basis! (plot r v)
  "PLOT's plane from the state R, V: eh the unit normal of r × v, ex the
ascending node's direction (x when equatorial), ey = eh × ex. Nil without a plane."
  (let ((eh (autopilot-plot-eh plot)) (ex (autopilot-plot-ex plot)) (ey (autopilot-plot-ey plot)))
    (vec3-cross! eh r v)
    (let ((n (vec3-norm eh)))
      (when (> n 1d-9)
        (vec3-scale! eh eh (/ n))
        (let ((node (sqrt (+ (expt (aref eh 0) 2) (expt (aref eh 1) 2)))))
          (if (> node 1d-6)
              (vec3-set! ex (/ (- (aref eh 1)) node) (/ (aref eh 0) node) 0d0)
              (vec3-set! ex 1d0 0d0 0d0)))
        (vec3-cross! ey eh ex)
        t))))

(declaim (inline plot-xy plot-push! plot-put!))
(defun plot-xy (plot x y z)
  "(values px py): the inertial point (X Y Z) in the plane's metres."
  (declare (type autopilot-plot plot) (type double-float x y z))
  (let ((ex (autopilot-plot-ex plot)) (ey (autopilot-plot-ey plot)))
    (values (+ (* x (aref ex 0)) (* y (aref ex 1)) (* z (aref ex 2)))
            (+ (* x (aref ey 0)) (* y (aref ey 1)) (* z (aref ey 2))))))

(defun plot-push! (plot x y z)
  "The inertial point (X Y Z) as the next plot point, in the plane's metres."
  (declare (type autopilot-plot plot) (type double-float x y z))
  (let ((n (autopilot-plot-n plot)))
    (when (< n +plot-points+)
      (multiple-value-bind (a b) (plot-xy plot x y z)
        (setf (aref (autopilot-plot-px plot) n) a
              (aref (autopilot-plot-py plot) n) b
              (autopilot-plot-n plot) (1+ n))))))

(defun plot-run-begin! (plot kind)
  (let ((i (autopilot-plot-runs plot)))
    (when (< i +plot-runs+)
      (setf (aref (autopilot-plot-run-start plot) i) (autopilot-plot-n plot)
            (svref (autopilot-plot-run-kind plot) i) kind
            (aref (autopilot-plot-run-end plot) i) (autopilot-plot-n plot)))))

(defun plot-run-end! (plot)
  (let ((i (autopilot-plot-runs plot)))
    (when (< i +plot-runs+)
      (setf (aref (autopilot-plot-run-end plot) i) (autopilot-plot-n plot))
      (incf (autopilot-plot-runs plot)))))

(defun plot-add-path! (plot pred from to kind &optional start-r)
  "The stored path of PRED from FROM to TO as a run of KIND: its position at
FROM (START-R when given), the nodes between at a stride that keeps them within
the point budget, and the last of them. Nil without two nodes after FROM."
  (declare (type autopilot-plot plot) (type prediction pred) (type double-float from to))
  (let ((first (trajectory-first-node pred from)))
    (when (and first (< from to))
      (let* ((nodes (prediction-nodes pred)) (count (prediction-count pred))
             (last (let ((i (1- count)))
                     (loop while (and (> i first) (> (node-t nodes i) to)) do (decf i))
                     i))
             (span (1+ (- last first)))
             (stride (max 1 (ceiling span (- *autopilot-plot-path-points* 2))))
             (scratch (autopilot-plot-scratch plot)))
        (declare (type fixnum first count last span stride))
        (plot-run-begin! plot kind)
        (if start-r
            (plot-push! plot (aref start-r 0) (aref start-r 1) (aref start-r 2))
            (when (prediction-position! scratch pred from)
              (plot-push! plot (aref scratch 0) (aref scratch 1) (aref scratch 2))))
        (flet ((node (i)
                 (let ((k (* +node-size+ i)))
                   (plot-push! plot (aref nodes (+ k 1)) (aref nodes (+ k 2)) (aref nodes (+ k 3))))))
          (loop for i of-type fixnum from first to last by stride do (node i))
          (unless (zerop (mod (- last first) stride)) (node last)))
        (plot-run-end! plot)
        t))))

(declaim (ftype (function (t t t) (values double-float double-float &optional)) plot-conic-elements!))
(defun plot-conic-elements! (plot r v)
  "The osculating orbit of R, V about Earth: (values e p), the periapsis
direction (the radius' when circular) left in PLOT's evec and eh × evec in q."
  (declare (type autopilot-plot plot) (type vec3 r v))
  (let* ((mu +mu-earth+) (evec (autopilot-plot-evec plot)) (q (autopilot-plot-q plot))
         (rn (vec3-norm r)) (v2 (vec3-dot v v)) (rv (vec3-dot r v))
         (h (autopilot-plot-scratch plot)))
    (vec3-cross! h r v)
    (dotimes (k 3)
      (setf (aref evec k) (/ (- (* (- v2 (/ mu rn)) (aref r k)) (* rv (aref v k))) mu)))
    (let* ((e (vec3-norm evec)) (hn (vec3-norm h)) (p (/ (* hn hn) mu)))
      (if (< e 1d-9)
          (vec3-scale! evec r (/ rn))
          (vec3-scale! evec evec (/ e)))
      (vec3-scale! h h (/ hn))
      (vec3-cross! q h evec)
      (values e p))))

(defun plot-add-conic! (plot r v count kind)
  "The osculating orbit of R, V about Earth as a run of COUNT segments (an
ellipse closed; a hyperbola out to five times the radius); its e, or nil for
a parabola's neighbourhood."
  (declare (type autopilot-plot plot) (type vec3 r v) (type fixnum count))
  (multiple-value-bind (e p) (plot-conic-elements! plot r v)
    (declare (type double-float e p))
    (let ((evec (autopilot-plot-evec plot)) (q (autopilot-plot-q plot)) (rn (vec3-norm r)))
      (declare (type double-float rn))
      (plot-run-begin! plot kind)
      (flet ((point (x y)
               (declare (type double-float x y))
               (plot-push! plot (+ (* x (aref evec 0)) (* y (aref q 0)))
                           (+ (* x (aref evec 1)) (* y (aref q 1)))
                           (+ (* x (aref evec 2)) (* y (aref q 2))))))
        (if (< e 1d0)
            (let* ((a (/ p (- 1d0 (* e e)))) (b (* a (sqrt (- 1d0 (* e e))))))
              (declare (type double-float a b))
              (dotimes (i (1+ count))
                (let ((big-e (/ (* 2d0 pi i) count)))
                  (declare (type double-float big-e))
                  (point (* a (- (cos big-e) e)) (* b (sin big-e))))))
            (let* ((a (/ p (- (* e e) 1d0))) (b (* a (sqrt (- (* e e) 1d0))))
                   (hm (acosh (max 1d0 (/ (+ 1d0 (/ (* 5 rn) a)) e)))))
              (declare (type double-float a b hm))
              (dotimes (i (1+ count))
                (let ((big-h (* hm (- (* 2d0 (/ i (float count 1d0))) 1d0))))
                  (declare (type double-float big-h))
                  (point (* a (- e (cosh big-h))) (* b (sinh big-h))))))))
      (plot-run-end! plot)
      e)))

;;; Drawing

(defun plot-put! (plot index a0 b0 a1 b1 colour width)
  "Segment INDEX from (A0 B0) to (A1 B1), clipped to the plot's rectangle,
nothing when outside. Returns the next index."
  (declare (type autopilot-plot plot) (type fixnum index) (type double-float a0 b0 a1 b1)
           (type single-float width) (type (simple-array single-float (3)) colour))
  (let* ((x0 (- (autopilot-plot-cx plot) (autopilot-plot-hw plot)))
         (x1 (+ (autopilot-plot-cx plot) (autopilot-plot-hw plot)))
         (y0 (- (autopilot-plot-cy plot) (autopilot-plot-hh plot)))
         (y1 (+ (autopilot-plot-cy plot) (autopilot-plot-hh plot)))
         (dx (- a1 a0)) (dy (- b1 b0)) (t0 0d0) (t1 1d0))
    (declare (type double-float dx dy t0 t1))
    (when (>= index +plot-segments+) (return-from plot-put! index))
    (flet ((clip (p q)
             (declare (type double-float p q))
             (cond ((= p 0d0) (>= q 0d0))
                   ((< p 0d0) (let ((r (/ q p))) (when (> r t1) (return-from plot-put! index)) (setf t0 (max t0 r)) t))
                   (t (let ((r (/ q p))) (when (< r t0) (return-from plot-put! index)) (setf t1 (min t1 r)) t)))))
      (declare (inline clip))
      (unless (and (clip (- dx) (- a0 x0)) (clip dx (- x1 a0)) (clip (- dy) (- b0 y0)) (clip dy (- y1 b0)))
        (return-from plot-put! index)))
    (when (> t0 t1) (return-from plot-put! index))
    (plane-put! (autopilot-plot-region plot) index (autopilot-plot-frame plot)
                (float (+ a0 (* t0 dx)) 1f0) (float (+ b0 (* t0 dy)) 1f0) 0f0
                (float (+ a0 (* t1 dx)) 1f0) (float (+ b0 (* t1 dy)) 1f0) 0f0
                colour width)
    (1+ index)))

(defun plot-ticks-add! (plot pred shot mode plan tr)
  "The plan's burns not yet over, at their centre times on the path: engaged on
PRED's, else on SHOT's."
  (declare (type autopilot-plot plot))
  (setf (autopilot-plot-ticks plot) 0)
  (let ((scratch (autopilot-plot-scratch plot)) (burns (burn-plan-burns plan)))
    (dotimes (i (min 6 (length burns)))
      (let* ((burn (svref burns i)) (start (planned-burn-start burn))
             (time (* 0.5d0 (+ start (max start (planned-burn-cut-t burn))))))
        (when (and (> (max start (planned-burn-cut-t burn)) tr)
                   (if (eq mode :engaged)
                       (or (and pred (prediction-position! scratch pred time))
                           (and shot (prediction-position! scratch shot time)))
                       (and shot (prediction-position! scratch shot time))))
          (let ((k (autopilot-plot-ticks plot)))
            (multiple-value-bind (a b) (plot-xy plot (aref scratch 0) (aref scratch 1) (aref scratch 2))
              (setf (aref (autopilot-plot-tick-x plot) k) a
                    (aref (autopilot-plot-tick-y plot) k) b))
            (incf (autopilot-plot-ticks plot))))))))

(defun autopilot-plot-gather! (plot state)
  "PLOT's points, runs, ticks and marks for the render STATE; the number of
runs, nil without an orbit plane."
  (declare (type autopilot-plot plot) (type render-state state))
  (let* ((r (render-state-r state)) (v (render-state-v state))
         (model (render-state-autopilot-model state))
         (pred (render-state-prediction state))
         (tr (render-state-t state)))
    (setf (autopilot-plot-n plot) 0 (autopilot-plot-runs plot) 0 (autopilot-plot-ticks plot) 0
          (autopilot-plot-mark-p plot) nil)
    (unless (plot-basis! plot r v) (return-from autopilot-plot-gather! nil))
    (multiple-value-bind (plan shot mode) (if model (autopilot-map-plan model) (values nil nil nil))
      (let* ((dash-t (and plan (plan-dash-start plan tr mode)))
             (end (and pred (prediction-sim pred) (> (prediction-count pred) 1)
                       (node-t (prediction-nodes pred) (1- (prediction-count pred)))))
             (path (and pred (prediction-sim pred) (eq (sim-body (prediction-sim pred)) :earth)
                        (trajectory-first-node pred tr))))
        (cond ((and path (eq mode :engaged) dash-t (< tr dash-t end))
               (plot-add-path! plot pred tr dash-t :solid r)
               (plot-add-path! plot pred dash-t end :dashed))
              (path (plot-add-path! plot pred tr end :solid r))
              (t (plot-add-conic! plot r v *autopilot-plot-conic-points* :solid)))
        (when (and shot dash-t (eq mode :shown))
          (plot-add-path! plot shot (max dash-t (shot-first-time shot) tr)
                          (node-t (prediction-nodes shot) (1- (prediction-count shot))) :dashed))
        (when (and plan (member mode '(:shown :engaged)))
          (plot-ticks-add! plot pred shot mode plan tr))
        ;; the own orbit's apsides, the ship, the target's orbit
        (multiple-value-bind (e p) (plot-conic-elements! plot r v)
          (let ((evec (autopilot-plot-evec plot)) (m (autopilot-plot-marks plot)))
            (flet ((mark (i distance sign)
                     (multiple-value-bind (a b)
                         (plot-xy plot (* sign distance (aref evec 0)) (* sign distance (aref evec 1))
                                  (* sign distance (aref evec 2)))
                       (setf (aref m i) a (aref m (1+ i)) b))))
              (when (> e 1d-3)
                (mark 2 (/ p (+ 1d0 e)) 1d0)
                (when (< e 1d0) (mark 0 (/ p (- 1d0 e)) -1d0))
                (setf (autopilot-plot-mark-p plot) (if (< e 1d0) :both :pe))))))
        (multiple-value-bind (a b) (plot-xy plot (aref r 0) (aref r 1) (aref r 2))
          (setf (aref (autopilot-plot-marks plot) 4) a (aref (autopilot-plot-marks plot) 5) b))
        (setf (autopilot-plot-scale-n plot) (autopilot-plot-n plot))
        (when (render-state-target state)
          (let ((tr-r (render-state-target-r state)) (tr-v (render-state-target-v state)))
            (when (and (> (vec3-norm tr-r) 1d0)
                       (> (vec3-norm (vec3-cross! (autopilot-plot-scratch plot) tr-r tr-v)) 1d0))
              (let ((e (plot-add-conic! plot tr-r tr-v *autopilot-plot-target-points* :target)))
                (when (>= e 1d0)
                  (decf (autopilot-plot-runs plot))
                  (setf (autopilot-plot-n plot) (autopilot-plot-scale-n plot)))))))
        (autopilot-plot-runs plot)))))

(defun autopilot-plot-update! (plot state)
  "Write PLOT's segments for the render STATE (autopilot-plot-segments!)."
  (autopilot-plot-segments! plot state))

(defun autopilot-plot-placement (state)
  "How the plot is placed for STATE's autopilot model: :full (rows 1 to 7),
:third (rows 5 to 7) or nil (the menu's rows are the screen's)."
  (let ((model (render-state-autopilot-model state)))
    (if (null model)
        :full
        (ecase (autopilot-model-state model)
          ((:closed :off) :full)
          ((:planning :shown :engaged) :third)
          ((:menu :refused) nil)))))

(defun autopilot-plot-segments! (plot state)
  "The plot of STATE's orbit in PLOT's region: Earth's disc (strips and outline),
the runs, marks, ticks; the rest of the region zeroed. The number of segments
written, 0 when the menu covers the plot or the ship has no orbit plane."
  (declare (type autopilot-plot plot) (type render-state state))
  (let ((mode (autopilot-plot-placement state))
        (region (autopilot-plot-region plot)))
    (setf (autopilot-plot-mode plot) mode (autopilot-plot-segments plot) 0)
    (unless (and mode (autopilot-plot-gather! plot state))
      (line-region-clear! region)
      (setf (autopilot-plot-mode plot) nil)
      (return-from autopilot-plot-segments! 0))
    (destructuring-bind (x0 ytop rh cell columns) (autopilot-plot-grid plot)
      (declare (type double-float x0 ytop rh cell) (type fixnum columns))
      (let* ((rows (if (eq mode :full) 7 3)) (first-row (if (eq mode :full) 0 4)))
        (setf (autopilot-plot-hh plot) (float (* 0.5d0 rows rh) 1f0)
              (autopilot-plot-hw plot) (float (* 0.5d0 columns cell) 1f0)
              (autopilot-plot-cx plot) (float (+ x0 (* 0.5d0 columns cell)) 1f0)
              (autopilot-plot-cy plot) (float (- ytop (* (+ first-row (* 0.5d0 rows)) rh)) 1f0))))
    (let* ((n (autopilot-plot-n plot)) (px (autopilot-plot-px plot)) (py (autopilot-plot-py plot))
           (scale (let ((best +radius-earth+))
                    (declare (type double-float best))
                    (dotimes (i (autopilot-plot-scale-n plot))
                      (setf best (max best (sqrt (+ (* (aref px i) (aref px i)) (* (aref py i) (aref py i)))))))
                    (when (eq (autopilot-plot-mark-p plot) :both)
                      (let ((m (autopilot-plot-marks plot)))
                        (setf best (max best (sqrt (+ (* (aref m 0) (aref m 0)) (* (aref m 1) (aref m 1))))))))
                    best))
           (unit (/ (* (the double-float *autopilot-plot-fraction*) (float (autopilot-plot-hh plot) 1d0)) scale))
           (cx (float (autopilot-plot-cx plot) 1d0)) (cy (float (autopilot-plot-cy plot) 1d0))
           (index 0) (widths *autopilot-plot-widths*))
      (declare (type fixnum index) (type double-float scale unit cx cy))
      (setf (autopilot-plot-unit plot) unit)
      (flet ((xs (x) (declare (type double-float x)) (+ cx (* unit x)))
             (ys (y) (declare (type double-float y)) (+ cy (* unit y))))
        (declare (inline xs ys))
        (let* ((radius (* unit +radius-earth+))
               (strips (if (eq mode :full) (the fixnum *autopilot-plot-fill-strips*) (floor (the fixnum *autopilot-plot-fill-strips*) 2)))
               (step (/ (* 2 radius) strips)))
          (declare (type double-float radius step) (type fixnum strips))
          ;; the disc: strips across it, then its outline
          (dotimes (k strips)
            (let* ((y (+ (- radius) (* (+ k 0.5d0) step)))
                   (half (sqrt (the (double-float 0d0) (max 0d0 (- (* radius radius) (* y y)))))))
              (declare (type double-float y half))
              (setf index (plot-put! plot index (- cx half) (+ cy y) (+ cx half) (+ cy y)
                                     (autopilot-plot-fill plot) (float (* 1.05d0 step) 1f0)))))
          (dotimes (k (the fixnum *autopilot-plot-ring*))
            (let ((a0 (/ (* 2d0 pi k) (the fixnum *autopilot-plot-ring*)))
                  (a1 (/ (* 2d0 pi (1+ k)) (the fixnum *autopilot-plot-ring*))))
              (declare (type double-float a0 a1))
              (setf index (plot-put! plot index (+ cx (* radius (cos a0))) (+ cy (* radius (sin a0)))
                                     (+ cx (* radius (cos a1))) (+ cy (* radius (sin a1)))
                                     (autopilot-plot-grey plot) (getf widths :outline))))))
        ;; the runs
        (dotimes (run (autopilot-plot-runs plot))
          (let* ((kind (svref (autopilot-plot-run-kind plot) run))
                 (colour (if (eq kind :target) (autopilot-plot-magenta plot) (autopilot-plot-cyan plot)))
                 (width (if (eq kind :target) (getf widths :target) (getf widths :path)))
                 (from (aref (autopilot-plot-run-start plot) run)) (to (aref (autopilot-plot-run-end plot) run)))
            (loop for i from from below (1- to)
                  do (when (or (not (eq kind :dashed)) (evenp (floor (- i from) 2)))
                       (setf index (plot-put! plot index (xs (aref px i)) (ys (aref py i))
                                              (xs (aref px (1+ i))) (ys (aref py (1+ i))) colour width))))))
        ;; Ap and Pe diamonds, the ship's ring, the burns' ticks
        (let ((m (autopilot-plot-marks plot)) (cyan (autopilot-plot-cyan plot)) (width (getf widths :mark)))
          (flet ((diamond (x y)
                   (declare (type double-float x y))
                   (let ((x (xs x)) (y (ys y)) (d 0.0028d0))
                     (declare (type double-float x y d))
                     (setf index (plot-put! plot index (- x d) y x (+ y d) cyan width)
                           index (plot-put! plot index x (+ y d) (+ x d) y cyan width)
                           index (plot-put! plot index (+ x d) y x (- y d) cyan width)
                           index (plot-put! plot index x (- y d) (- x d) y cyan width)))))
            (declare (inline diamond))
            (when (autopilot-plot-mark-p plot)
              (diamond (aref m 2) (aref m 3))
              (when (eq (autopilot-plot-mark-p plot) :both) (diamond (aref m 0) (aref m 1)))))
          (let ((x (xs (aref m 4))) (y (ys (aref m 5))) (ring 0.0025d0))
            (dotimes (k 8)
              (let ((a0 (/ (* 2d0 pi k) 8)) (a1 (/ (* 2d0 pi (1+ k)) 8)))
                (declare (type double-float a0 a1))
                (setf index (plot-put! plot index (+ x (* ring (cos a0))) (+ y (* ring (sin a0)))
                                       (+ x (* ring (cos a1))) (+ y (* ring (sin a1))) cyan width)))))
          (dotimes (k (autopilot-plot-ticks plot))
            (let* ((x (aref (autopilot-plot-tick-x plot) k)) (y (aref (autopilot-plot-tick-y plot) k))
                   (norm (max 1d-9 (sqrt (+ (* x x) (* y y))))) (ux (/ x norm)) (uy (/ y norm))
                   (px (xs x)) (py (ys y)))
              (setf index (plot-put! plot index (- px (* 0.003d0 ux)) (- py (* 0.003d0 uy))
                                     (+ px (* 0.003d0 ux)) (+ py (* 0.003d0 uy))
                                     cyan (* 2f0 width))))))
        (line-region-clear! region index)
        (setf (autopilot-plot-segments plot) index)
        index))))
