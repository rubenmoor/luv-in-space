(define-test flights-on-station
  ;; docs/story.md "On station at F": 150 m and 0.10 m/s.
  (flet ((pass (sim station)
           (first (entry-pass (lis::run-flight (format nil "((:expect :on-station ~S))" station)
                                               :sim sim)
                              "ON-STATION"))))
    (true (pass (lis::stated-sim '(:orbit (:on-axis :k-17 100))) :k-17))
    (false (pass (lis::stated-sim '(:orbit (:on-axis :k-17 151))) :k-17))
    (let* ((sim (lis::stated-sim '(:orbit (:on-axis :k-17 100))))
           (ship (lis::sim-ship sim)))
      (lis::vec3-add-scaled! (lis::ship-state-v ship) (lis::ship-state-v ship)
                             (lis::quat-rotate (lis::ship-state-q ship) (lis::vec3 0 1 0)) 0.11d0)
      (false (pass sim :k-17)))
    (true (pass (lis::stated-sim '(:orbit (:on-axis (:tern-station :berth) 140))) '(:tern-station :berth)))
    (false (pass (lis::stated-sim '(:orbit (:on-axis :k-17 100))) '(:tern-station :berth)))
    ;; Skua Yard: the stack's CoM at its stop point (decision 121).
    (let* ((sim (lis::stated-sim '(:orbit (:near :skua-yard :at-slot))))
           (ship (lis::sim-ship sim)))
      (lis::stop-point-into! (lis::ship-state-r ship) (lis::ship-state-v ship) sim :skua-yard
                             (lis::rendezvous-fixture sim :skua-yard) 0d0 (lis::sim-t sim))
      (lis::vec3-add-scaled! (lis::ship-state-r ship) (lis::ship-state-r ship)
                             (lis::vec3-normalize (lis::ship-state-r ship)) 140d0)
      (true (pass sim :skua-yard))
      (lis::vec3-add-scaled! (lis::ship-state-r ship) (lis::ship-state-r ship)
                             (lis::vec3-normalize (lis::ship-state-r ship)) 20d0)
      (false (pass sim :skua-yard)))))

(defun shot-steps-per-second (record a b)
  (/ (- (lis::sim-steps (lis::flight-entry-sim (shot record b)))
        (lis::sim-steps (lis::flight-entry-sim (shot record a))))
     (- (shot-t record b) (shot-t record a))))

(define-test flights-coast-caps
  ;; Within 1 km of a promoted K-17: ×4, every step fine.
  (let ((record (lis::run-flight "((:start :state (:orbit (:on-axis :k-17 100)))
 (:warp :coast) (:screenshot \"a\") (:after 60) (:screenshot \"b\"))")))
    (true (lis::flight-record-passed-p record))
    (is = 64 (shot-steps-per-second record "a" "b")))
  ;; Berthed: above ×4.
  (let ((record (lis::run-flight "((:start :state (:berthed (:tern-station :berth)))
 (:warp :coast) (:screenshot \"a\") (:after 600) (:screenshot \"b\"))")))
    (true (lis::flight-record-passed-p record))
    (true (< (shot-steps-per-second record "a" "b") 1)))
  ;; (:translate …) at ×1 under (:warp :coast).
  (let* ((sim (lis::stated-sim '(:orbit (:near :k-17 :behind 5000))))
         (flight (lis::new-flight (lis::read-flight "((:warp :coast) (:translate :up :dv 0.05))") sim))
         (clock (lis::new-clock sim)))
    (lis::flight-step-hook flight clock sim)
    (is = 1 (lis::clock-level clock))
    (is equalp #(0 0 -1) (lis::controls-translation-keys (lis::sim-controls sim)))
    (is = 1 (lis::flight-coast-cap flight sim))))

(define-test flights-contact-dropout
  ;; Into Skua Yard 1 at 2 m/s: warp drops for the contact, which kills.
  (let* ((sim (lis::stated-sim '(:orbit (:on-axis :skua-yard-1 300))))
         (ship (lis::sim-ship sim)))
    (lis::vec3-add-scaled! (lis::ship-state-v ship) (lis::ship-state-v ship)
                           (lis::quat-rotate (lis::ship-state-q ship) (lis::vec3 1 0 0)) 2d0)
    (let ((record (lis::run-flight "((:warp :coast) (:wait :drop-out :contact :within 600)
 (:screenshot \"dropped\") (:wait :lost :contact :within 60) (:expect :lost :contact))" :sim sim)))
      (true (lis::flight-record-passed-p record) "~A" (script-record-lines record))
      (false (lis::sim-loss (lis::flight-entry-sim (shot record "dropped"))))
      (is eq :contact (lis::loss-cause (lis::flight-entry-loss (first (last record))))))))

(define-test flights-close-prediction
  ;; RCS held 60 s at ×1: the prediction restarts once per 10 s, not per step.
  (multiple-value-bind (record sim flight clock)
      (lis::run-flight "((:keys (:h) :for 60))")
    (declare (ignore sim flight))
    (true (lis::flight-record-passed-p record))
    (true (<= (lis::prediction-restarts (lis::clock-prediction clock)) 7)
          "~D restarts" (lis::prediction-restarts (lis::clock-prediction clock))))
  ;; At ×1 the prediction steers no step: refreshed before every step, the same sim.
  (let ((script "((:keys (:h :w) :for 2))"))
    (let ((sparse (nth-value 1 (lis::run-flight script)))
          (dense (let ((lis::*flight-close-prediction-interval* 0d0))
                   (nth-value 1 (lis::run-flight script)))))
      (true (equalp sparse dense)))))

