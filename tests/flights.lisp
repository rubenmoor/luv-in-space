(defun plan-burn-entries (record)
  (remove-if-not (lambda (e) (and (eq (lis::flight-entry-kind e) :burn) (lis::flight-entry-label e)))
                 record))

(define-test flights-autopilot-set-ap
  ;; Two-body: one :apsis burn, engaged at the request + 60 s.
  (let ((script "((:autopilot :set-ap 500e3) (:warp :coast) (:wait :autopilot-done :within 20000))"))
    (multiple-value-bind (record sim flight) (lis::run-flight script :model :point)
      (true (lis::flight-record-passed-p record) "~A" (script-record-lines record))
      (let ((engage (lis::flight-engage flight))
            (burns (plan-burn-entries record)))
        (is = (+ (lis::start-t) lis::*plan-barrier*) (lis::flight-engage-time engage))
        (is = 1 (length burns))
        (is = 1 (count :burn record :key #'lis::flight-entry-kind))
        (let* ((burn (first burns))
               (plan (lis::flight-engage-plan engage))
               (dv (- (lis::ship-state-dv (lis::sim-ship sim)) (lis::flight-engage-dv engage)))
               (planned (lis::planned-burn-dv (svref (lis::burn-plan-burns plan) 0)))
               (start (lis::flight-entry-start burn))
               (since (- (lis::sim-t sim) start)))
          (is eq :apsis (lis::flight-entry-label burn))
          (is = (lis::planned-burn-start (svref (lis::burn-plan-burns plan) 0)) start)
          (is = dv (lis::flight-entry-dv burn))
          (true (search "BURN APSIS FROM T+" (script-record-lines record)))
          (flet ((utc (time)
                   (let ((s (round (- time (lis::start-t)))))
                     (format nil "2040-01-01T~2,'0D:~2,'0D:~2,'0D"
                             (floor s 3600) (mod (floor s 60) 60) (mod s 60)))))
            (let ((checks (lis::run-flight
                           (format nil "(~A
 (:expect :dv-below ~F) (:expect :dv-below ~F)
 (:expect :burn :apsis :between ~S ~S) (:expect :burn :apsis :between ~S ~S)
 (:expect :since-burn :apsis :below ~F) (:expect :since-burn :apsis :below ~F)
 (:expect :elapsed-below 20000) (:expect :burn :plane :between \"2040-01-01\" \"2040-01-02\"))"
                                   (subseq script 1 (1- (length script)))
                                   (+ planned 1) (- planned 1)
                                   (utc (- start 1)) (utc (+ start 1)) (utc (+ start 1)) (utc (+ start 60))
                                   (+ since 1) (- since 1))
                           :model :point)))
              (is equal '(t nil) (entry-pass checks "DV-BELOW"))
              (is equal '(t nil nil) (entry-pass checks "BURN"))
              (is equal '(t nil) (entry-pass checks "SINCE-BURN"))
              (is equal '(t) (entry-pass checks "ELAPSED-BELOW"))))))))
  ;; The planner's refusal; Backspace before the burn.
  (is equal "PLAN REFUSED: BELOW 150 KM"
      (failure-text (lis::run-flight "((:autopilot :set-pe 120e3))" :model :point)))
  (let ((record (lis::run-flight "((:autopilot :set-ap 500e3) (:after 30 :autopilot :off)
 (:wait :autopilot-done))" :model :point)))
    (true (search "AUTOPILOT OFF" (failure-text record)) "~A" (failure-text record))
    (is = (+ (lis::start-t) 90) (lis::flight-entry-t (first (last record))))
    (is = 0 (count :burn record :key #'lis::flight-entry-kind)))
  ;; Nothing engaged: the record's expectations fail.
  (is equal '(nil nil) (entry-pass (lis::run-flight "((:expect :dv-below 10) (:expect :aim-point 1))")
                                   "")))

(define-test flights-clearance
  ;; A straight pass of K-17 at 10 m/s, 300 m abeam: the relative Hermite's least.
  (let* ((sim (lis::stated-sim '(:orbit (:on-axis :k-17 2000))))
         (clock (lis::new-clock sim))
         (flight (lis::new-flight '() sim))
         (k-17 (lis::sim-object sim :k-17))
         (object (lis::object-state k-17))
         (ship (lis::sim-ship sim))
         (u (lis::vec3 10 0 0)))
    (true (lis::object-promoted-p k-17))
    (flet ((place! (p)
             ;; the ship at the object's position less P, moving at its velocity less U
             (replace (lis::ship-state-r ship) (lis::vec3-sub (lis::ship-state-r object) p))
             (replace (lis::ship-state-v ship) (lis::vec3-sub (lis::ship-state-v object) u))))
      (place! (lis::vec3 -500 300 0))
      (setf (lis::sim-plan sim) nil
            (lis::flight-engage flight) (lis::make-flight-engage clock sim))
      (let ((engage (lis::flight-engage flight)))
        (lis::flight-clearance-update! engage sim)
        (incf (lis::sim-t sim) 100d0)
        (lis::vec3-add-scaled! (lis::ship-state-r object) (lis::ship-state-r object)
                               (lis::ship-state-v object) 100d0)
        (place! (lis::vec3 500 300 0))
        (lis::flight-clearance-update! engage sim)
        (let ((least (aref (lis::flight-engage-least engage) (position k-17 (lis::sim-objects sim)))))
          (true (< (abs (- least 300d0)) 1d-3) "least ~,6F m" least))
        (flet ((pass (text)
                 (lis::record-condition flight sim (first (lis::read-flight text)))))
          (true (pass "((:expect :clearance-above 299))"))
          (false (pass "((:expect :clearance-above 301))"))
          (false (pass "((:expect :clearance-above 301 :only (:k-17)))"))
          (true (pass "((:expect :clearance-above 301 :only (:tern-station)))"))
          (true (pass "((:expect :clearance-above 301 :except (:k-17)))"))
          (multiple-value-bind (holds value) (pass "((:expect :clearance-above 1 :until :aim-point))")
            (false holds)
            (is equal "NO ARRIVAL BURN" value)))))))

(define-test flights-autopilot-live
  ;; The job spread over frames engages at the same t: equal to run-flight's.
  (let ((script "((:autopilot :set-ap 500e3) (:warp :coast) (:wait :autopilot-done :within 20000)
 (:expect :dv-below 40))"))
    (multiple-value-bind (record sim) (lis::run-flight script :model :point)
      (true (lis::flight-record-passed-p record) "~A" (script-record-lines record))
      (dolist (elapsed-list '((1/60) (0.013d0 0.021d0 0.0007d0 0.05d0 0.2d0 0.016d0 0d0)))
        (multiple-value-bind (live live-sim planning) (flown-by-frames script elapsed-list :model :point)
          (true (> planning 1) "~A: planned in ~D frames" elapsed-list planning)
          (true (equalp sim live-sim) "~A: end sims differ" elapsed-list)
          (true (record-equal record live) "~A: records differ~%~A~%~A" elapsed-list
                (script-record-lines record) (script-record-lines live)))))))
