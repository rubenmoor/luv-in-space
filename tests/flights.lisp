(defun entry-pass (record label)
  "The pass of RECORD's :expect entries whose label starts with LABEL, in order."
  (loop for e in record
        when (and (eq (lis::flight-entry-kind e) :expect)
                  (eql 0 (search label (lis::flight-entry-label e))))
          collect (lis::flight-entry-pass e)))

(define-test flights-run-berth-transfer
  ;; Berthed at Fulmar Depot: 1,000 kg at 10 kg/s, then out by 0.2 m/s aft.
  (let ((record (lis::run-flight "((:start :state (:berthed (:fulmar-depot :a) :propellant 27000))
 (:expect :berthed (:fulmar-depot :a))
 (:transfer :on)
 (:wait :propellant-full :within 200)
 (:screenshot \"full\")
 (:release)
 (:translate :aft :dv 0.2)
 (:screenshot \"away\")
 (:expect :berthed (:fulmar-depot :a)))")))
    (is = 100 (- (shot-t record "full") (lis::flight-entry-t (first record))))
    (is equal '(t nil) (entry-pass record "BERTHED"))
    (false (lis::flight-record-failure record))
    (let* ((full (lis::flight-entry-sim (shot record "full")))
           (away (lis::flight-entry-sim (shot record "away")))
           (growth (- (lis::ship-state-dv (lis::sim-ship away)) (lis::ship-state-dv (lis::sim-ship full))))
           ;; One fine step's RCS Δv at most: four thrusters on the stack.
           (step (/ (* 4 lis::*rcs-thrust* lis::+fine-step+)
                    (+ lis::*ship-dry-mass* lis::*propellant-full* -10))))
      (is = lis::*propellant-full* (lis::ship-state-m-p (lis::sim-ship full)))
      (true (lis::sim-berthed full))
      (false (lis::sim-transfer full))
      (false (lis::sim-berthed away))
      (is eq :armed (lis::grapple-state (lis::sim-grapple away)))
      (is equalp #(0 0 0) (lis::controls-translation-keys (lis::sim-controls away)))
      (true (<= 0.2d0 growth (+ 0.2d0 step)) "odometer +~,6F m/s" growth)))
  ;; Refusals with the game's text.
  (is equal "NOT BERTHED" (failure-text (lis::run-flight "((:transfer :on))")))
  (is equal "NO PROPELLANT HERE"
      (failure-text (lis::run-flight "((:start :state (:berthed (:tern-station :berth))) (:transfer :on))")))
  (is equal "ENGINE LOCKED: BERTHED"
      (failure-text (lis::run-flight "((:start :state (:berthed (:tern-station :berth)))
 (:translate :aft :dv 0.1))")))
  (is equal "(:RELEASE): NOTHING HELD" (failure-text (lis::run-flight "((:release))")))
  (true (search "(:RELEASE) FIRST"
                (failure-text (lis::run-flight "((:start :state (:berthed (:tern-station :berth)))
 (:grapple :stow))")))))

