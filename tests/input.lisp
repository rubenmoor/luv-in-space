(in-package #:luv-in-space.tests)

;;; input.lisp: the held-key map, the event path, taps, focus and quit
;;; (decision 81: Input in milestone 2: held keys per frame, taps, gating
;;; and the shared key map). A game without a canvas or renderer.

(defun input-game ()
  (let ((sim (lis::new-game-sim)))
    (make-instance 'lis::game :sim sim :clock (lis::new-clock sim)
                              :start-checkpoint (lis::take-checkpoint sim))))

(defun key-event (game kind key &key modifiers repeat)
  (lis::handle-event game (make-instance (ecase kind
                                           (:press 'luv:canvas-key-press-event)
                                           (:release 'luv:canvas-key-release-event))
                                         :timestamp 0 :key-name key
                                         :modifiers modifiers :repeat-p repeat)))

(defun window-event (game class)
  (lis::handle-event game (make-instance class :timestamp 0)))

(defun input-frame (game)
  (lis::input-frame! game 1/60))

(defun game-controls (game) (lis::sim-controls (lis::game-sim game)))

(defun rotation-keys (game) (lis::controls-rotation-keys (game-controls game)))
(defun translation-keys (game) (lis::controls-translation-keys (game-controls game)))

(define-test input-held-keys
  (let ((game (input-game)))
    (is eq :hold (lis::controls-attitude-mode (game-controls game)))
    (key-event game :press :w)
    (input-frame game)
    (is equalp #(0 -1 0) (rotation-keys game))
    (is eq :rate-damping (lis::controls-attitude-mode (game-controls game)))
    (input-frame game)
    (is equalp #(0 -1 0) (rotation-keys game))
    (key-event game :release :w)
    (input-frame game)
    (is equalp #(0 0 0) (rotation-keys game))
    (key-event game :press :w)
    (key-event game :press :s)
    (input-frame game)
    (is equalp #(0 0 0) (rotation-keys game)))
  (loop for (key kind axis sign) in lis::*flight-keys*
        for index = (position axis (if (eq kind :rotation) '(:roll :pitch :yaw) '(:x :y :z)))
        do (let ((game (input-game))
                 (expected (vector 0 0 0)))
             (setf (aref expected index) sign)
             (key-event game :press key)
             (input-frame game)
             (is equalp expected (if (eq kind :rotation) (rotation-keys game) (translation-keys game))
                 "~A" key)
             (is equalp #(0 0 0) (if (eq kind :rotation) (translation-keys game) (rotation-keys game))
                 "~A" key))))

(define-test input-tap
  (let ((game (input-game)))
    (key-event game :press :w)
    (key-event game :release :w)
    (input-frame game)
    (is equalp #(0 -1 0) (rotation-keys game))
    (input-frame game)
    (is equalp #(0 0 0) (rotation-keys game))))

(define-test input-repeat-and-stray-release
  (let ((game (input-game)))
    (key-event game :press :w :repeat t)
    (key-event game :release :s)
    (input-frame game)
    (is equalp #(0 0 0) (rotation-keys game))
    (is eq :hold (lis::controls-attitude-mode (game-controls game)))
    (is eq nil (lis::input-held (lis::game-input game)))
    (is eq nil (lis::input-released (lis::game-input game)))))

(define-test input-focus-loss
  (let ((game (input-game)))
    (lis::controls-set-throttle (game-controls game) 0.5d0)
    (key-event game :press :w)
    (key-event game :press :h)
    (input-frame game)
    (is equalp #(0 -1 0) (rotation-keys game))
    (is equalp #(1 0 0) (translation-keys game))
    (window-event game 'luv:canvas-window-focus-lost-event)
    (input-frame game)
    (is equalp #(0 0 0) (rotation-keys game))
    (is equalp #(0 0 0) (translation-keys game))
    (is = 0.5d0 (lis::controls-throttle (game-controls game)))))

(define-test input-quit
  (flet ((quits-p (thunk)
           (let ((game (input-game)))
             (funcall thunk game)
             (lis::game-quit-requested-p game))))
    (true (quits-p (lambda (g) (key-event g :press :escape))))
    (true (quits-p (lambda (g) (key-event g :press :q :modifiers '(:control)))))
    (true (quits-p (lambda (g) (window-event g 'luv:canvas-window-close-request-event))))
    (false (quits-p (lambda (g) (key-event g :press :q))))))

(define-test controls-apply-held-keys
  (let ((c (lis::new-controls)))
    (lis::controls-apply-held-keys! c '(:a :d :q))
    (is equalp #(-1 0 0) (lis::controls-rotation-keys c))
    (is eq :hold (lis::controls-attitude-mode c))
    (lis::controls-apply-held-keys! c '())
    (is equalp #(0 0 0) (lis::controls-rotation-keys c))))

;;; Part two: the key map's commands, the throttle ramp, gating and the
;;; title (decision 81, decision 88: Warp keys while paused).

(defun input-tap (game key)
  (key-event game :press key)
  (key-event game :release key))

(defun input-throttle (game) (lis::controls-throttle (game-controls game)))
(defun input-attitude (game)
  (let ((c (game-controls game)))
    (list (lis::controls-attitude-mode c) (lis::controls-hold c))))
(defun input-clock (game) (lis::game-clock game))

(defun input-frames (game n elapsed)
  (dotimes (i n) (lis::input-frame! game elapsed)))

(define-test input-throttle-ramp
  (flet ((ramped (elapsed)
           (let ((game (input-game)))
             (key-event game :press :shift-left)
             (input-frames game 1 elapsed)
             (is = 0.1d0 (input-throttle game))
             (input-frames game (round 1 elapsed) elapsed)
             (input-throttle game))))
    (true (< (abs (- 0.6d0 (ramped 1/60))) 1d-9))
    (true (< (abs (- 0.6d0 (ramped 1/144))) 1d-9)))
  (let ((game (input-game)))
    (lis::controls-set-throttle (game-controls game) 0.5d0)
    (key-event game :press :shift-left)
    (input-frames game 1 0.5d0)
    (true (< (abs (- 0.55d0 (input-throttle game))) 1d-12))
    (input-frames game 60 1/60)
    (is = 1d0 (input-throttle game)))
  (let ((game (input-game)))
    (lis::controls-set-throttle (game-controls game) 0.15d0)
    (key-event game :press :control-left)
    (input-frames game 12 1/60)
    (is = 0d0 (input-throttle game))
    (key-event game :release :control-left)
    (input-tap game :z)
    (is = 1d0 (input-throttle game))
    (input-tap game :x)
    (is = 0d0 (input-throttle game)))
  (let ((game (input-game)))
    (lis::controls-set-throttle (game-controls game) 0.5d0)
    (key-event game :press :control-left)
    (input-frames game 1 1/60)
    (key-event game :press :q :modifiers '(:control))
    (true (lis::game-quit-requested-p game))
    (true (< (abs (- (- 0.5d0 (/ 0.5d0 60)) (input-throttle game))) 1d-12))
    (is equalp #(0 0 0) (rotation-keys game))))

(define-test input-commands
  (let ((game (input-game)))
    (is equal '(:hold :prograde) (input-attitude game))
    (input-tap game :|1|)
    (is eq :rate-damping (first (input-attitude game)))
    (input-tap game :|1|)
    (is equal '(:hold :prograde) (input-attitude game))
    (input-tap game :|5|)
    (is equal '(:hold :radial-out) (input-attitude game))
    (input-tap game :r)
    (is equal '(:hold :inertial) (input-attitude game))
    (is equalp (lis::ship-state-q (lis::sim-ship (lis::game-sim game)))
        (lis::controls-inertial-target (game-controls game)))
    (input-tap game :t)
    (is eq :rate-damping (first (input-attitude game)))
    (input-tap game :t)
    (is eq :direct (first (input-attitude game)))
    (input-tap game :f)
    (true (lis::controls-fine (game-controls game)))
    (input-tap game :f)
    (false (lis::controls-fine (game-controls game))))
  (let ((game (input-game)))
    (input-tap game :|.|)
    (input-tap game :|.|)
    (is = 10 (lis::clock-level (input-clock game)))
    (input-tap game :|,|)
    (is = 4 (lis::clock-level (input-clock game)))
    (input-tap game :/)
    (is = 1 (lis::clock-level (input-clock game)))
    (input-tap game :|.|)
    (input-tap game :p)
    (true (lis::clock-paused (input-clock game)))
    (input-tap game :p)
    (false (lis::clock-paused (input-clock game)))
    (is = 4 (lis::clock-level (input-clock game)))))

(define-test input-gating-paused
  (let ((game (input-game)))
    (lis::controls-set-throttle (game-controls game) 0.5d0)
    (input-tap game :p)
    (key-event game :press :w)
    (key-event game :press :shift-left)
    (input-tap game :|1|)
    (input-frames game 10 1/60)
    (is equalp #(0 0 0) (rotation-keys game))
    (is equal '(:hold :prograde) (input-attitude game))
    (is = 0.5d0 (input-throttle game))
    (input-tap game :|.|)
    (is = 4 (lis::clock-level (input-clock game)))
    (true (lis::clock-paused (input-clock game)))
    (input-tap game :p)
    (false (lis::clock-paused (input-clock game)))
    (input-frames game 1 1/60)
    (is equalp #(0 -1 0) (rotation-keys game))))

(define-test input-gating-kinematic
  (let ((game (input-game)))
    (input-tap game :|.|)
    (input-tap game :|.|)
    (is = 10 (lis::clock-level (input-clock game)))
    (key-event game :press :w)
    (input-frames game 1 1/60)
    (is equalp #(0 0 0) (rotation-keys game))
    (is equal '(:hold :prograde) (input-attitude game))
    (is equal '("RCS OFF ABOVE ×4") (lis::clock-messages (input-clock game)))
    (key-event game :release :w)
    (input-tap game :h)
    (input-frames game 1 1/60)
    (is equalp #(0 0 0) (translation-keys game))
    (is equal '("RCS OFF ABOVE ×4") (lis::clock-messages (input-clock game)))
    (key-event game :press :shift-left)
    (input-frames game 3 1/60)
    (true (< 0.1d0 (input-throttle game)))
    (input-tap game :|2|)
    (is equal '(:hold :retrograde) (input-attitude game))))

(define-test input-gating-lost
  (let* ((game (input-game))
         (sim (lis::game-sim game)))
    (setf (lis::sim-loss sim) (lis::make-loss :crash :earth 0d0 100d0 0d0 0d0))
    ;; N restarts while lost (input-return-and-n).
    (dolist (key (append (remove :n (mapcar #'first lis::*flight-keys*))
                         '(:f :z :t :r :|2| :|5| :shift-left)))
      (key-event game :press key))
    (input-frames game 3 1/60)
    (is equalp #(0 0 0) (rotation-keys game))
    (is equalp #(0 0 0) (translation-keys game))
    (is equal '(:hold :prograde) (input-attitude game))
    (false (lis::controls-fine (game-controls game)))
    (is = 0d0 (input-throttle game))))

(define-test input-gating-flight
  ;; decision 87: while a flight runs, flight, warp and restart keys do
  ;; nothing and no held keys are written; M still acts.
  (let ((game (input-game)))
    (lis::fly "burn" :game game)
    (true (lis::flight-running-p game))
    (key-event game :press :w)
    (key-event game :press :shift-left)
    (dolist (key '(:f :z :t :r :|2| :|.| :n :return))
      (input-tap game key))
    (input-frames game 3 1/60)
    (is equalp #(0 0 0) (rotation-keys game))
    (is equal '(:hold :prograde) (input-attitude game))
    (false (lis::controls-fine (game-controls game)))
    (is = 0d0 (input-throttle game))
    (is = 1 (lis::clock-level (input-clock game)))
    (input-tap game :m)
    (is eq :map (lis::game-view game))
    (input-tap game :m)
    (is eq :outside (lis::game-view game))
    (lis::flight-stop :game game)
    (false (lis::flight-running-p game))
    (false (lis::clock-hook (input-clock game)))
    (input-frames game 1 1/60)
    (is equalp #(0 -1 0) (rotation-keys game))))

(defun title-names-key-p (title key)
  "KEY's label among TITLE's tokens: letters inside an upper-case group,
digits inside the 1–6 range, the rest by name."
  (let ((tokens (loop for word in (uiop:split-string title :separator " ")
                      append (cons word (and (> (length word) 1)
                                             (uiop:split-string word :separator "/"))))))
    (flet ((token-p (string) (member string tokens :test #'string=)))
      (case key
        ((:|1| :|2| :|3| :|4| :|5| :|6|) (token-p "1–6"))
        (:shift-left (token-p "Shift"))
        (:control-left (token-p "Ctrl"))
        (:escape (token-p "Esc"))
        (:home (token-p "Home"))
        (t (let ((name (string key)))
             (if (and (= 1 (length name)) (alpha-char-p (char name 0)))
                 (some (lambda (token) (and (every #'upper-case-p token)
                                            (find (char name 0) token)))
                       tokens)
                 (token-p name))))))))

(define-test input-window-title
  (let ((title (lis::window-title)))
    (true (search "Luv in Space" title))
    (dolist (key (append (mapcar #'first lis::*flight-keys*)
                         (mapcar #'car lis::*key-map*)
                         '(:shift-left :control-left :escape)))
      ;; Tab and the Page keys are the map's, not main keys (decision 81);
      ;; the LOST panel names Return (decision 86).
      (unless (member key '(:tab :page-up :page-down :return))
        (true (title-names-key-p title key) "~A" key)))))

;;; The pointer and the camera keys (decision 82: Outside view camera:
;;; angles in a frame, toggles that keep the picture, distance and easing).

(defun pointer-event (game class &rest initargs)
  (lis::handle-event game (apply #'make-instance class :timestamp 0 :x 0.0 :y 0.0 initargs)))

(defun outside-view (game) (lis::game-outside-view game))

(define-test input-right-drag
  (let ((game (input-game)))
    (pointer-event game 'luv:canvas-pointer-button-press-event :button :right)
    (pointer-event game 'luv:canvas-pointer-motion-event :delta-x 8.0 :delta-y 0.0)
    (pointer-event game 'luv:canvas-pointer-motion-event :delta-x -4.0 :delta-y 0.0)
    (pointer-event game 'luv:canvas-pointer-button-release-event :button :right)
    (input-frame game)
    (true (< (abs (- (lis::outside-view-azimuth (outside-view game)) (* 179 (/ pi 180)))) 1d-12))
    (pointer-event game 'luv:canvas-pointer-motion-event :delta-x 8.0 :delta-y 8.0)
    (input-frame game)
    (true (< (abs (- (lis::outside-view-azimuth (outside-view game)) (* 179 (/ pi 180)))) 1d-12))
    (is = (* 20 (/ pi 180)) (lis::outside-view-elevation (outside-view game)))
    ;; Focus loss ends a drag.
    (pointer-event game 'luv:canvas-pointer-button-press-event :button :right)
    (window-event game 'luv:canvas-window-focus-lost-event)
    (pointer-event game 'luv:canvas-pointer-motion-event :delta-x 8.0 :delta-y 0.0)
    (input-frame game)
    (true (< (abs (- (lis::outside-view-azimuth (outside-view game)) (* 179 (/ pi 180)))) 1d-12))))

(define-test input-wheel
  (let ((game (input-game)))
    (pointer-event game 'luv:canvas-pointer-wheel-event :scroll-y 1.0)
    (pointer-event game 'luv:canvas-pointer-wheel-event :scroll-y 1.0)
    (input-frame game)
    (true (< (abs (- (lis::outside-view-target (outside-view game)) (/ 40d0 1.44d0))) 1d-12))))

(define-test input-camera-keys-while-paused
  (let* ((game (input-game))
         (view (outside-view game)))
    (lis::render-state-update! (lis::game-render-state game) (lis::game-clock game) (lis::game-sim game))
    (setf (lis::clock-paused (lis::game-clock game)) t)
    (key-event game :press :c)
    (is eq :locked (lis::outside-view-frame view))
    (pointer-event game 'luv:canvas-pointer-wheel-event :scroll-y -3.0)
    (input-frame game)
    (true (> (lis::outside-view-target view) 40d0))
    (key-event game :press :home)
    (is eq :orbital (lis::outside-view-frame view))
    (is = 40d0 (lis::outside-view-target view))
    (is = pi (lis::outside-view-azimuth view))))

;;; The map's keys and pointer (decision 83: Map camera: framing on opening,
;;; focus, zoom, drag and exposure).

(defun map-view (game) (lis::game-map-view game))

(defun outside-pose (game)
  (let ((view (outside-view game)))
    (list (lis::outside-view-frame view) (lis::outside-view-azimuth view)
          (lis::outside-view-elevation view) (lis::outside-view-distance view)
          (lis::outside-view-target view))))

(define-test input-map-toggle
  (let ((game (input-game)))
    (lis::outside-view-drag! (outside-view game) 30d0 -20d0)
    (lis::outside-view-zoom! (outside-view game) 2 0d0)
    (let ((pose (outside-pose game)))
      (input-tap game :m)
      (is eq :map (lis::game-view game))
      (true (lis::game-view-changed-p game))
      (is eq :earth (lis::map-view-focus (map-view game)))
      (true (> (lis::map-view-target (map-view game)) lis::+radius-earth+))
      (input-tap game :m)
      (is eq :outside (lis::game-view game))
      (is equal pose (outside-pose game)))))

(define-test input-map-keys
  (let ((game (input-game)))
    ;; Page keys and Tab do nothing outside the map.
    (let ((view (copy-structure (map-view game))))
      (dolist (key '(:tab :page-up :page-down))
        (input-tap game key))
      (is equalp view (map-view game)))
    (input-tap game :m)
    (let* ((view (map-view game))
           (opening (lis::map-view-target view))
           (pose (outside-pose game)))
      (input-tap game :page-down)
      (true (< (abs (- (lis::map-view-target view) (* 10 opening))) (* 1d-12 opening)))
      (input-tap game :page-up)
      (true (< (abs (- (lis::map-view-target view) opening)) (* 1d-12 opening)))
      (input-tap game :tab)
      (is eq :ship (lis::map-view-focus view))
      (input-tap game :tab)
      (is eq :earth (lis::map-view-focus view))
      (pointer-event game 'luv:canvas-pointer-wheel-event :scroll-y 1.0)
      (pointer-event game 'luv:canvas-pointer-wheel-event :scroll-y 1.0)
      (input-frame game)
      (true (< (abs (- (lis::map-view-target view) (/ opening 1.44d0))) (* 1d-12 opening)))
      (pointer-event game 'luv:canvas-pointer-button-press-event :button :right)
      (pointer-event game 'luv:canvas-pointer-motion-event :delta-x 40.0 :delta-y 0.0)
      (input-frame game)
      (true (< (abs (- (lis::map-view-azimuth view) (* -55 (/ pi 180)))) 1d-12))
      (let ((map (copy-structure view)))
        (input-tap game :c)
        (is equalp map view))
      (input-tap game :home)
      (true (< (abs (- (lis::map-view-azimuth view) (* -45 (/ pi 180)))) 1d-12))
      (true (< (abs (- (lis::map-view-target view) opening)) (* 1d-12 opening)))
      (is equal pose (outside-pose game)))))

(define-test input-map-while-paused-and-lost
  (dolist (setup (list (lambda (game) (setf (lis::clock-paused (lis::game-clock game)) t))
                       (lambda (game)
                         (setf (lis::sim-loss (lis::game-sim game))
                               (lis::make-loss :crash :earth 0d0 100d0 0d0 0d0)))))
    (let ((game (input-game)))
      (funcall setup game)
      (input-tap game :m)
      (is eq :map (lis::game-view game))
      (let* ((view (map-view game))
             (opening (lis::map-view-target view)))
        (input-tap game :tab)
        (is eq :ship (lis::map-view-focus view))
        (input-tap game :page-down)
        (true (< (abs (- (lis::map-view-target view) (* 10 opening))) (* 1d-12 opening))))
      (input-tap game :m)
      (is eq :outside (lis::game-view game)))))
;;; Death and restart (decision 86: Death view, LOST panel and restart in
;;; milestone 2): game-frame! is draw's frame without the GPU.

(defun game-frames (game n)
  (dotimes (i n) (lis::game-frame! game 1/60)))

(defun deorbit-game ()
  "A game 5 s before the deorbit impact of hazards' tests, in :map."
  (let* ((orbit (dive-orbit (- *earth-crash-radius* 50d3)))
         (impact (lis::orbit-radius-crossings orbit *earth-crash-radius* (lis::start-t)))
         (sim (orbit-sim orbit (lis::grid-ceiling (- impact 5))))
         (game (make-instance 'lis::game :sim sim :clock (lis::new-clock sim)
                                         :start-checkpoint (lis::take-checkpoint
                                                            (lis::new-game-sim)))))
    (lis::toggle-map! game)
    game))

(define-test game-death-record
  (let* ((game (deorbit-game))
         (lis::*frame-step-time-limit* nil))
    (lis::outside-view-drag! (outside-view game) 40d0 10d0)
    (let ((pose (copy-structure (outside-view game))))
      (is eq :map (lis::game-view game))
      (game-frames game 1)
      (false (lis::game-death-time game))
      (loop repeat 600 until (lis::sim-lost-p (lis::game-sim game))
            do (game-frames game 1))
      (true (lis::sim-lost-p (lis::game-sim game)))
      (is eq :outside (lis::game-view game))
      (is equalp pose (outside-view game))
      (is eq (lis::sim-loss (lis::game-sim game)) (lis::game-loss game))
      (let ((death (lis::game-death-time game)))
        (true (and death (= death (lis::game-real-time game))))
        (game-frames game 10)
        (is = death (lis::game-death-time game))))))

(define-test game-restart
  (let* ((game (deorbit-game))
         (lis::*frame-step-time-limit* nil))
    (loop repeat 600 until (lis::sim-lost-p (lis::game-sim game))
          do (game-frames game 1))
    (true (lis::sim-lost-p (lis::game-sim game)))
    (lis::outside-view-drag! (outside-view game) 40d0 10d0)
    (lis::toggle-map! game)
    (lis::clock-toggle-pause (lis::game-clock game))
    (key-event game :press :n)
    (pointer-event game 'luv:canvas-pointer-button-press-event :button :right)
    (lis::game-restart! game)
    (true (equalp (lis::game-sim game) (lis::new-game-sim)))
    (is = 1 (lis::clock-level (lis::game-clock game)))
    (false (lis::clock-paused (lis::game-clock game)))
    (is eq :outside (lis::game-view game))
    (is equalp (lis::new-outside-view) (outside-view game))
    (false (lis::input-held (lis::game-input game)))
    (false (lis::input-drag (lis::game-input game)))
    (false (lis::game-loss game))
    (false (lis::game-death-time game))
    (true (lis::game-view-changed-p game))
    (game-frames game 1)
    (is equalp #(0 0 0) (translation-keys game))
    (let ((fresh (input-game)))
      (game-frames game 999)
      (game-frames fresh 1000)
      (true (equalp (lis::game-sim game) (lis::game-sim fresh))))))

(defun lost-game ()
  "A game lost at the deorbit impact, run there by game-frame!."
  (let ((game (deorbit-game))
        (lis::*frame-step-time-limit* nil))
    (loop repeat 600 until (lis::sim-lost-p (lis::game-sim game))
          do (game-frames game 1))
    game))

(define-test input-return-and-n
  ;; Flying: N translates, Return is unbound.
  (let ((game (input-game)))
    (key-event game :press :n)
    (input-frame game)
    (is equalp #(-1 0 0) (translation-keys game))
    (key-event game :release :n)
    (key-event game :press :return)
    (input-frame game)
    (is equalp #(0 0 0) (translation-keys game))
    (true (equalp (lis::game-sim game) (lis::new-game-sim))))
  ;; Lost: W and 1 change nothing; Return and N restart, to the same sim.
  (let ((sims '()))
    (dolist (key '(:return :n))
      (let* ((game (lost-game))
             (sim (lis::game-sim game))
             (attitude (input-attitude game)))
        (true (lis::sim-lost-p sim))
        (input-tap game :w)
        (input-tap game :|1|)
        (input-frame game)
        (is equalp #(0 0 0) (rotation-keys game))
        (is equal attitude (input-attitude game))
        (true (lis::sim-lost-p sim))
        (key-event game :press key)
        (false (lis::sim-lost-p sim))
        (true (equalp sim (lis::new-game-sim)))
        (key-event game :release key)
        (false (lis::input-held (lis::game-input game)))
        (input-frame game)
        (is equalp #(0 0 0) (translation-keys game))
        (push (lis::copy-sim sim) sims)))
    (true (equalp (first sims) (second sims)))))

;;; G, B, Y and the latest checkpoint (decision 112: Grapple, stack and berth
;;; in the sim: state, notices to the clock, the latest checkpoint; decision
;;; 113: Grapple and contact details the design leaves open).

(defun grapple-state (game) (lis::grapple-state (lis::sim-grapple (lis::game-sim game))))

(defun berth-at! (game key)
  "GAME's sim berthed at KEY's fixture 0, as decision 112's state reads."
  (let* ((sim (lis::game-sim game))
         (grapple (lis::sim-grapple sim)))
    (setf (lis::grapple-state grapple) :latched
          (lis::grapple-object grapple) (position key (lis::sim-objects sim) :key #'lis::object-key)
          (lis::grapple-fixture grapple) 0
          (lis::sim-berthed sim) t)
    game))

(define-test input-grapple-key
  (let ((game (input-game)))
    (is eq :stowed (grapple-state game))
    (input-tap game :g)
    (is eq :armed (grapple-state game))
    (input-tap game :g)
    (is eq :stowed (grapple-state game))
    ;; Every warp level.
    (lis::clock-set-level-index! (input-clock game) (position 1000 lis::*warp-levels*))
    (input-tap game :g)
    (is eq :armed (grapple-state game))
    (setf (lis::grapple-state (lis::sim-grapple (lis::game-sim game))) :closing)
    (input-tap game :g)
    (is eq :closing (grapple-state game))
    (is equal '("RELEASE LOCKED: CLAWS CLOSING") (lis::clock-messages (input-clock game))))
  ;; Paused, lost, a flight running: nothing.
  (dolist (setup (list (lambda (game) (setf (lis::clock-paused (lis::game-clock game)) t))
                       (lambda (game)
                         (setf (lis::sim-loss (lis::game-sim game))
                               (lis::make-loss :crash :earth 0d0 100d0 0d0 0d0)))
                       (lambda (game) (lis::fly "burn" :game game))))
    (let ((game (input-game)))
      (funcall setup game)
      (input-tap game :g)
      (is eq :stowed (grapple-state game))
      (input-tap game :b)
      (false (lis::clock-messages (input-clock game))))))

(define-test input-transfer-key
  (let ((game (input-game)))
    (input-tap game :b)
    (is equal '("NOT BERTHED") (lis::clock-messages (input-clock game)))
    (berth-at! game :tern-station)
    (input-tap game :b)
    (is equal '("NO PROPELLANT HERE") (lis::clock-messages (input-clock game)))
    (false (lis::sim-transfer (lis::game-sim game))))
  (dolist (key '(:fulmar-depot :highport))
    (let ((game (berth-at! (input-game) key)))
      (true (lis::object-def-depot (lis::object-definition key)))
      (input-tap game :b)
      (true (lis::sim-transfer (lis::game-sim game)) "~A" key)
      (false (lis::clock-messages (input-clock game)))
      (input-tap game :b)
      (false (lis::sim-transfer (lis::game-sim game))))))

(define-test input-engine-locked
  ;; Berthed: throttle and RCS keys give the message once per press, held
  ;; or tapped, and leave the controls as they were.
  (let* ((game (berth-at! (input-game) :tern-station))
         (controls (lis::copy-controls (game-controls game))))
    (dolist (key '(:w :q :h :l :z :shift-left :control-left))
      (setf (lis::clock-message-list (input-clock game)) nil)
      (key-event game :press key)
      (input-frames game 30 1/60)
      (is equal '("ENGINE LOCKED: BERTHED") (lis::clock-messages (input-clock game)) "~A" key)
      (key-event game :release key)
      (input-frame game)
      (is = 1 (count "ENGINE LOCKED: BERTHED" (lis::clock-log (input-clock game))
                     :key #'second :test #'equal)
          "~A" key)
      (setf (lis::clock-log (input-clock game)) nil))
    (true (equalp controls (game-controls game))))
  ;; Unberthed the same keys act.
  (let ((game (input-game)))
    (input-tap game :z)
    (is = 1d0 (input-throttle game))
    (false (lis::clock-messages (input-clock game)))))

(define-test input-acknowledge-key
  (let* ((game (input-game))
         (clock (input-clock game)))
    (lis::clock-message! clock :refused "ONE")
    (is = 1 (length (lis::clock-log-unread clock)))
    ;; Paused and while a flight runs Y acts.
    (setf (lis::clock-paused clock) t)
    (input-tap game :y)
    (false (lis::clock-log-unread clock))
    (setf (lis::clock-paused clock) nil)
    (lis::fly "burn" :game game)
    (lis::clock-message! clock :refused "TWO")
    (input-tap game :y)
    (false (lis::clock-log-unread clock))
    (lis::flight-stop :game game)
    ;; Lost: not.
    (lis::clock-message! clock :refused "THREE")
    (setf (lis::sim-loss (lis::game-sim game)) (lis::make-loss :crash :earth 0d0 100d0 0d0 0d0))
    (input-tap game :y)
    (is = 1 (length (lis::clock-log-unread clock)))))

(define-test input-return-to-checkpoint
  (let* ((game (input-game))
         (sim (lis::game-sim game))
         (clock (input-clock game))
         (lis::*frame-step-time-limit* nil))
    (game-frames game 30)
    (setf (lis::sim-checkpoint-request sim) t)
    (game-frames game 1)
    (let ((checkpoint (lis::copy-sim (lis::clock-checkpoint clock))))
      (true checkpoint)
      (false (equalp checkpoint (lis::new-game-sim)))
      (game-frames game 30)
      (setf (lis::sim-loss sim) (lis::make-loss :crash :earth (lis::sim-t sim) 100d0 0d0 0d0))
      (input-tap game :return)
      (false (lis::sim-lost-p sim))
      (true (equalp sim checkpoint))
      (is = 1 (lis::clock-level clock))
      ;; Again after a second death: the checkpoint stays.
      (game-frames game 30)
      (setf (lis::sim-loss sim) (lis::make-loss :crash :earth (lis::sim-t sim) 100d0 0d0 0d0))
      (input-tap game :return)
      (true (equalp sim checkpoint))
      ;; N: the start, the checkpoint cleared.
      (setf (lis::sim-loss sim) (lis::make-loss :crash :earth (lis::sim-t sim) 100d0 0d0 0d0))
      (input-tap game :n)
      (true (equalp sim (lis::new-game-sim)))
      (false (lis::clock-checkpoint clock))
      (setf (lis::sim-loss sim) (lis::make-loss :crash :earth (lis::sim-t sim) 100d0 0d0 0d0))
      (input-tap game :return)
      (true (equalp sim (lis::new-game-sim))))))
